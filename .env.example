POSTGRES_PASSWORD=changeme

# Copy backend/.env.example to backend/.env too — the api service reads its
# own env file, this one is only consumed by docker-compose.yml directly
# (POSTGRES_PASSWORD). Domain routing/TLS is handled by Dokploy's Traefik,
# configured via the Dokploy dashboard, not via env vars here.

# Invoice Generator desktop app (app/invoice-tool/*) — gates access, one
# password per profile. Not stored anywhere, checked on every request.
INVOICE_PASSWORD_HAKEEMI=123
INVOICE_PASSWORD_EZZY=changeme

# Optional prefill defaults for each profile's form (leave blank to type manually)
HAKEEMI_BUSINESS_NAME=
HAKEEMI_EMAIL=
HAKEEMI_PHONE=
HAKEEMI_BANK_NAME=
HAKEEMI_BANK_ACCOUNT=
HAKEEMI_BANK_HOLDER=
EZZY_BUSINESS_NAME=
EZZY_EMAIL=
EZZY_PHONE=
EZZY_PAYMENT_INFO=
